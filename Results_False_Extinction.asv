clear;
clc;
close all;

load("BVD_Model_Fit.mat",'Parameters')
k=Parameters(:,1);
p=Parameters(:,2);
u=Parameters(:,4);
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Probability of extinction
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

Prob_True_Extinction=p.^k;
Prob_False_Extinction=p.^k.*(1-(1-u.*(1-p)).^k)./((1-u.*(1-p)).^k); 
Prob_Apparent_Extinction = Prob_True_Extinction + Prob_False_Extinction;
Conditional_Prob_Extinction = (1-u.*(1-p)).^k;

Ascertained_Cases = 1./Prob_False_Extinction; % Average of shifted geometric distribution 

% False extinction
b = betafit(Prob_False_Extinction);
mle = (b(1)-1)./(sum(b)-2);
mle_false_ext = mle;
lb = betainv(0.025,b(1),b(2));
ub = betainv(0.975,b(1),b(2));

display(['The probability of false extinction: ' num2str(mle,'%4.3f') ' (95% CrI: ' num2str(lb,'%4.3f') char(8211) num2str(ub,'%4.3f') ')']);

% Average number of ascertained cases before false extinction event
% b = gamfit(Ascertained_Cases);
mle = round(1./mle_false_ext);
ubt
lb = round(1./ubt);
ub = round(1./lbt);

display(['Number of ascertained cases before false extinction event: ' num2str(mle,'%4.3f') ' (95% CrI: ' num2str(lb,'%4.3f') char(8211) num2str(ub,'%4.3f') ')']);

% Apparent extinction
b = betafit(Prob_Apparent_Extinction);
mle = (b(1)-1)./(sum(b)-2);
lb = betainv(0.025,b(1),b(2));
ub = betainv(0.975,b(1),b(2));

display(['The probability of apparent extinction: ' num2str(mle,'%4.3f') ' (95% CrI: ' num2str(lb,'%4.3f') char(8211) num2str(ub,'%4.3f') ')']);

% True extinction: Conditional on extinction
b = betafit(Conditional_Prob_Extinction);
mle = (b(1)-1)./(sum(b)-2);
lb = betainv(0.025,b(1),b(2));
ub = betainv(0.975,b(1),b(2));

display(['Conditional on apparent extinctio, the probability of true extinction: ' num2str(mle,'%4.3f') ' (95% CrI: ' num2str(lb,'%4.3f') char(8211) num2str(ub,'%4.3f') ')']);

N_Confirmed = 5514;
x=[0:N_Confirmed];

False_Ext_Events = zeros(length(k),1);

L = binopdf(x,N_Confirmed,mle_false_ext);
False_Ext_Events_mle = x(L==max(L));

for jj=1:length(False_Ext_Events)
    L = binopdf(x,N_Confirmed,Prob_False_Extinction(jj));
    False_Ext_Events(jj)=x(L==max(L));
end

lb = prctile(False_Ext_Events,2.5);
ub = prctile(False_Ext_Events,97.5);

display(['From ' num2str(N_Confirmed) ' cases, the number of false extinction events: ' num2str(False_Ext_Events_mle,'%d') ' (95% CrI: ' num2str(lb,'%d') char(8211) num2str(ub,'%d') ')']);

