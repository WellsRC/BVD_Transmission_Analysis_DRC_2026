clear;
clc;
close all;

N_Samp=10^4;
[k_mle,p_mle,p_fatal_mle,p_non_fatal_mle,cfr_mle,k,p,p_fatal,p_non_fatal,cfr,R0_mle,R0,R0_Fatal_mle,R0_Fatal,R0_Non_fatal_mle,R0_Non_fatal] = BVD_Parameters(N_Samp);

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Probability of extinction
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

Prob_Extinction_Index=p.^k;
Prob_Extinction_Index_F=p_fatal.^k;
Prob_Extinction_Index_NF=p_non_fatal.^k;

figure('units','normalized','outerposition',[0.05 0.05 0.9 1]);


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Baseline
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

x=linspace(0,1,1001);

subplot('Position',[0.06 0.75 0.25 0.18])
par_beta=betafit(Prob_Extinction_Index);

plot(x,betapdf(x,par_beta(1),par_beta(2)),'k','LineWidth',2);

set(gca,'LineWidth',2,'Fontsize',12,'tickdir','out')
ylabel('Probability density','FontSize',14)
xlabel('Probability of extinction at index case','FontSize',14)
box off;
xlim([0.4 0.8]);
ylim([0 15]);
text(-0.23,0.99,'A','FontSize',28,'VerticalAlignment','middle','Units','normalized');
text(0.5,1.1,'Baseline','FontSize',16,'VerticalAlignment','bottom','Units','normalized','HorizontalAlignment','center');



%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Fatal
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
subplot('Position',[0.37 0.75 0.25 0.18])

par_beta=betafit(Prob_Extinction_Index_F);

plot(x,betapdf(x,par_beta(1),par_beta(2)),'k','LineWidth',2);

set(gca,'LineWidth',2,'Fontsize',12,'tickdir','out')
ylabel('Probability density','FontSize',14)
xlabel('Probability of extinction at index case','FontSize',14)
box off;
xlim([0.4 0.8]);
ylim([0 15]);
text(-0.23,0.99,'B','FontSize',28,'VerticalAlignment','middle','Units','normalized');

text(0.5,1.1,'Fatal index case','FontSize',16,'VerticalAlignment','bottom','Units','normalized','HorizontalAlignment','center');

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Non-fatal
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
subplot('Position',[0.68 0.75 0.25 0.18])

par_beta=betafit(Prob_Extinction_Index_NF);

plot(x,betapdf(x,par_beta(1),par_beta(2)),'k','LineWidth',2);

set(gca,'LineWidth',2,'Fontsize',12,'tickdir','out')
ylabel('Probability density','FontSize',14)
xlabel('Probability of extinction at index case','FontSize',14)
box off;
xlim([0.4 0.8]);
ylim([0 15]);
text(-0.23,0.99,'C','FontSize',28,'VerticalAlignment','middle','Units','normalized');
text(0.5,1.1,'Non-fatal index case','FontSize',16,'VerticalAlignment','bottom','Units','normalized','HorizontalAlignment','center');
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Probability unascertained first generation
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

Non_scaled_Relative_Unascertained_First = zeros(length(x),length([0.01:0.01:0.99]));
Non_scaled_Relative_Unascertained_First_F = zeros(length(x),length([0.01:0.01:0.99]));
Non_scaled_Relative_Unascertained_First_NF = zeros(length(x),length([0.01:0.01:0.99]));

Unascertained_First = zeros(length(x),length([0.01:0.01:0.99]));
Unascertained_First_F = zeros(length(x),length([0.01:0.01:0.99]));
Unascertained_First_NF = zeros(length(x),length([0.01:0.01:0.99]));

Relative_Unascertained_First = zeros(length(x),length([0.01:0.01:0.99]));
Relative_Unascertained_First_F = zeros(length(x),length([0.01:0.01:0.99]));
Relative_Unascertained_First_NF = zeros(length(x),length([0.01:0.01:0.99]));

for u=0.01:0.01:0.99
    Prob_Unascertained_First=p.^k.*(1-(1-u.*(1-p)).^k)./((1-u.*(1-p)).^k); 
    Prob_Unascertained_First_F=p_fatal.^k.*(1-(1-u.*(1-p_fatal)).^k)./((1-u.*(1-p_fatal)).^k); 
    Prob_Unascertained_First_NF=p_non_fatal.^k.*(1-(1-u.*(1-p_non_fatal)).^k)./((1-u.*(1-p_non_fatal)).^k); 

    par_beta=betafit(Prob_Unascertained_First);
    Unascertained_First(:,round(100.*u))=betapdf(x,par_beta(1),par_beta(2))./betapdf((par_beta(1)-1)./(sum(par_beta)-1),par_beta(1),par_beta(2));

    par_beta=betafit(Prob_Unascertained_First_F);
    Unascertained_First_F(:,round(100.*u))=betapdf(x,par_beta(1),par_beta(2))./betapdf((par_beta(1)-1)./(sum(par_beta)-1),par_beta(1),par_beta(2));

    par_beta=betafit(Prob_Unascertained_First_NF);
    Unascertained_First_NF(:,round(100.*u))=betapdf(x,par_beta(1),par_beta(2))./betapdf((par_beta(1)-1)./(sum(par_beta)-1),par_beta(1),par_beta(2));

    par_beta=betafit(Prob_Extinction_Index./(Prob_Extinction_Index+Prob_Unascertained_First));
    Relative_Unascertained_First(:,round(100.*u))=betapdf(x,par_beta(1),par_beta(2))./betapdf((par_beta(1)-1)./(sum(par_beta)-1),par_beta(1),par_beta(2));
    Non_scaled_Relative_Unascertained_First(:,round(100.*u))=betapdf(x,par_beta(1),par_beta(2));

    par_beta=betafit(Prob_Extinction_Index_F./(Prob_Extinction_Index_F+Prob_Unascertained_First_F));
    Relative_Unascertained_First_F(:,round(100.*u))=betapdf(x,par_beta(1),par_beta(2))./betapdf((par_beta(1)-1)./(sum(par_beta)-1),par_beta(1),par_beta(2));
    Non_scaled_Relative_Unascertained_First_F(:,round(100.*u))=betapdf(x,par_beta(1),par_beta(2));

    par_beta=betafit(Prob_Extinction_Index_NF./(Prob_Extinction_Index_NF+Prob_Unascertained_First_NF));
    Relative_Unascertained_First_NF(:,round(100.*u))=betapdf(x,par_beta(1),par_beta(2))./betapdf((par_beta(1)-1)./(sum(par_beta)-1),par_beta(1),par_beta(2));
    Non_scaled_Relative_Unascertained_First_NF(:,round(100.*u))=betapdf(x,par_beta(1),par_beta(2));
end

