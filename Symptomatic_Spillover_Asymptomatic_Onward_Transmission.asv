Color_Relative_Extinction=interp1(linspace(0,1,10),Color_Relative_Extinction,linspace(0,1,1001));

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Baseline
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

ax_G=subplot('Position',[0.06 0.275 0.25 0.18]);

contourf([0.01:0.01:0.99],x',Relative_Unascertained_First,'LineStyle','none');

set(gca,'LineWidth',2,'Fontsize',12,'tickdir','out','xtick',[0.01 0.1:0.1:0.9 0.99],'YTick',[0:0.2:1])
ylabel({'Relative','extinction probability'},'FontSize',14)
% xlabel('Under-ascertainment rate','FontSize',14)
