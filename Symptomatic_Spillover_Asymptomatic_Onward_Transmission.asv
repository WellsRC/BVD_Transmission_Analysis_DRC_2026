contourf([0.01:0.01:0.99],x',Relative_Unascertained_First_NF,'LineStyle','none');

set(gca,'LineWidth',2,'Fontsize',12,'tickdir','out','xtick',[0.01 0.1:0.1:0.9 0.99],'YTick',[0:0.2:1])
ylabel({'Relative','extinction probability'},'FontSize',14)
% xlabel('Under-ascertainment rate','FontSize',14)
box off;
text(-0.23,0.99,'I','FontSize',28,'VerticalAlignment','middle','Units','normalized');
xtickangle(0);
cb2 = colorbar;
cb2.Position= [0.94    0.275    0.0123    0.18];
cb2.Ticks=[0:0.2:1];
cb2.Label.String ='Normalized density';
cb2.Label.Rotation=270;
colormap(ax_I,Color_Relative_Extinction);

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Number unascertained generations
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%


uv=[0.01 0.1:0.1:0.9 0.99];

Undected_FG = zeros(20,length(uv));
Undected_FG_F = zeros(20,length(uv));
Undected_FG_NF = zeros(20,length(uv));

for uu=1:length(uv)
    u=uv(uu);
    Prob_Unascertained_First=p.^k.*(1-(1-u.*(1-p)).^k)./((1-u.*(1-p)).^k); 
    Prob_Unascertained_First_F=p_fatal.^k.*(1-(1-u.*(1-p_fatal)).^k)./((1-u.*(1-p_fatal)).^k); 
    Prob_Unascertained_First_NF=p_non_fatal.^k.*(1-(1-u.*(1-p_non_fatal)).^k)./((1-u.*(1-p_non_fatal)).^k); 
    var_epsilon_0=Prob_Extinction_Index./(Prob_Extinction_Index+Prob_Unascertained_First);
    var_epsilon_0_F=Prob_Extinction_Index_F./(Prob_Extinction_Index_F+Prob_Unascertained_First_F);
    var_epsilon_0_NF=Prob_Extinction_Index_NF./(Prob_Extinction_Index_NF+Prob_Unascertained_First_NF);
    parfor N_Spillover=1:20
        Events_Num=[0:N_Spillover];
        p_temp=zeros(N_Samp,N_Spillover+1);
        p_temp_F=zeros(N_Samp,N_Spillover+1);
        p_temp_NF=zeros(N_Samp,N_Spillover+1);
        
        for ii=1:N_Spillover+1
            p_temp(:,ii)=binopdf(Events_Num(ii),N_Spillover,1-var_epsilon_0); % Want to look at the numbr of potential asymptoamtic first generations
            p_temp_F(:,ii)=binopdf(Events_Num(ii),N_Spillover,1-var_epsilon_0_F); % Want to look at the numbr of potential asymptoamtic first generations
            p_temp_NF(:,ii)=binopdf(Events_Num(ii),N_Spillover,1-var_epsilon_0_NF); % Want to look at the numbr of potential asymptoamtic first generations
        end
        
        % Construct beta distributions for 0 chains to 4 chains
        beta_par=zeros(min(5,N_Spillover+1),2); % Looking only at the first few number of chains that could produce unascertained first generations
        beta_par_F=zeros(min(5,N_Spillover+1),2); % Looking only at the first few number of chains that could produce unascertained first generations
        beta_par_NF=zeros(min(5,N_Spillover+1),2); % Looking only at the first few number of chains that could produce unascertained first generations
        for ii=1:min(5,N_Spillover+1)
            beta_par(ii,:)=betafit(p_temp(:,ii));
            beta_par_F(ii,:)=betafit(p_temp_F(:,ii));
            beta_par_NF(ii,:)=betafit(p_temp_NF(:,ii));
        end
    
        % Identify the probability that maximizes the likelihood based on the
        % estimated beta distributions
        p_s=linspace(0.0001,0.9999,10^4);
        L=zeros(10^4,1);
        L_F=zeros(10^4,1);
        L_NF=zeros(10^4,1);
        % Likelihood for first few number of chains that could produce unascertained first generations
        for ii=1:10^4
            L(ii)=sum(log(betapdf(binopdf([0:min(5,N_Spillover+1)-1]',N_Spillover,p_s(ii)),beta_par(:,1),beta_par(:,2))));
            L_F(ii)=sum(log(betapdf(binopdf([0:min(5,N_Spillover+1)-1]',N_Spillover,p_s(ii)),beta_par_F(:,1),beta_par_F(:,2))));
            L_NF(ii)=sum(log(betapdf(binopdf([0:min(5,N_Spillover+1)-1]',N_Spillover,p_s(ii)),beta_par_NF(:,1),beta_par_NF(:,2))));
        end
        q_mle=p_s(L==max(L));
        L_Event = binopdf(Events_Num,N_Spillover,q_mle);
        Undected_FG(N_Spillover,uu)=max(Events_Num(L_Event==max(L_Event)));
    
        q_mle=p_s(L_F==max(L_F));
        L_Event = binopdf(Events_Num,N_Spillover,q_mle);
        Undected_FG_F(N_Spillover,uu)=max(Events_Num(L_Event==max(L_Event)));
    
        q_mle=p_s(L_NF==max(L_NF));
        L_Event = binopdf(Events_Num,N_Spillover,q_mle);
        Undected_FG_NF(N_Spillover,uu)=max(Events_Num(L_Event==max(L_Event)));
    end
end


