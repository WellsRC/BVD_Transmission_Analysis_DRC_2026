%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
ax_F=subplot('Position',[0.68 0.51 0.25 0.18]);

contourf([0.01:0.01:0.99],x',Unascertained_First_NF,'LineStyle','none');

set(gca,'LineWidth',2,'Fontsize',12,'tickdir','out','xtick',[0.01 0.1:0.1:0.9 0.99],'YTick',[0:0.2:1])
ylabel({'False','extinction probability'},'FontSize',14)
% xlabel('Under-ascertainment rate','FontSize',14)
box off;
text(-0.23,0.99,'F','FontSize',28,'VerticalAlignment','middle','Units','normalized');

cb = colorbar;
cb.Position= [0.94    0.51    0.0123    0.18];
