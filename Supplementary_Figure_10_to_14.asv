clear;
clc;
% 
% R0t=[0.2:0.2:2];
% kt=10.^linspace(-1,1,21);
% uv=[0.05 0.1:0.1:0.9 0.95];
% 
% [k,u,R0]=meshgrid(kt,uv,R0t);
% old_size=size(k);
% k=k(:);
% u=u(:);
% R0=R0(:);
% p=k./(k+R0);
% 
% Num_Gen=15;
% 
% 
% theta_G=zeros(Num_Gen+1,length(k)); 
% sigma_G_1=zeros(Num_Gen+1,length(k)); 
% 
% parfor kk=1:length(k)
%     theta_G_temp=zeros(Num_Gen+1,1); 
%     theta_G_temp(1)=nbinpdf(0,k(kk),p(kk)); % Probability extinct w/ index
% 
%     for gg=2:Num_Gen+1
%         theta_G_temp(gg)=p(kk).^k(kk)./(1-sum(theta_G_temp(1:(gg-1))).*(1-p(kk))).^k(kk)-sum(theta_G_temp(1:(gg-1)));
%     end
%     theta_G(:,kk)=theta_G_temp;
%     sigma_G_1(:,kk)=Sample_Approximation_Detection_Chain(Num_Gen,1,u(kk),k(kk),p(kk));
% end
% 
% save('Output_Fig_S10_S11_ALT.mat')

load('Output_Fig_S10_S11_ALT.mat');
Gen_Det=zeros(1,length(k));
E_Det = zeros(1,length(k));
for kk=1:length(k)
    pdf_1 =[sigma_G_1(1,kk); diff(sigma_G_1(:,kk),[],1)];
    pdf_1 = pdf_1./sum(pdf_1);
    theta_G_1=theta_G(:,kk);
    Gen_Det(kk) = [0:Num_Gen]*pdf_1;
    E_Det(kk) = theta_G_1'*pdf_1;
end

OR = cumsum(theta_G,1).*(1-sigma_G_1)./(sigma_G_1.*(1-cumsum(theta_G,1)));

PRCC = zeros(3,size(OR,1));
for gen=0:Num_Gen
    X=[u OR(gen+1,:)'];
    Z=[k R0];
    [temp_r]=partialcorr(X,Z,'Type','Spearman');
    
    PRCC(1,gen+1)=temp_r(1,2);
    
    X=[R0 OR(gen+1,:)'];
    Z=[k u ];
    [temp_r]=partialcorr(X,Z,'Type','Spearman');
    
    PRCC(2,gen+1)=temp_r(1,2);
    
    
    X=[k OR(gen+1,:)'];
    Z=[u R0];
    [temp_r]=partialcorr(X,Z,'Type','Spearman');
    
    PRCC(3,gen+1)=temp_r(1,2);
end


OR_Gen_1_R1 = reshape(OR(2,:),old_size);
OR_Gen_1_R1 = squeeze(OR_Gen_1_R1(:,:,1==R0t));

F = scatteredInterpolant(OR_Gen_1_R1(:),k(R0==1),u(R0==1));

Vq_k10 = F(1,10);
OR_Gen_2_R1 = reshape(OR(3,:),old_size);
OR_Gen_2_R1 = squeeze(OR_Gen_2_R1(:,:,1==R0t));
F = scatteredInterpolant(OR_Gen_2_R1(:),k(R0==1),u(R0==1));

Vq = F(1,10);

close all;


figure('units','normalized','outerposition',[0.1 0.3 0.8 0.5])
subplot('Position',[0.075 0.15 0.9 0.8])
plot([0:Num_Gen],zeros(size([0:Num_Gen])),':','LineWidth',1.5,'Color',[0.5 0.5 0.5]); hold on;
p1=plot([0:Num_Gen],PRCC(1,:),'color',hex2rgb('#F5BE41'),'LineWidth',2,'Marker','o'); hold on;
p2=plot([0:Num_Gen],PRCC(2,:),'color',hex2rgb('#31A9B8'),'LineWidth',2,'Marker','square'); hold on;
p3=plot([0:Num_Gen],PRCC(3,:),'color',hex2rgb('#CF3721'),'LineWidth',2,'Marker','hexagram'); hold on;
box off;
set(gca,'tickdir','out','Fontsize',12,'LineWidth',2,'XTick',[0:Num_Gen],'YTick',[-1:0.2:1])
xlabel('Generation','FontSize',14)
ylabel('Partial Rank Correlation Coefficient','FontSize',14)
legend([p1 p2 p3],{'Underascertainment','Basic reproduction number','Dispersion coefficient'},'Position',[0.819907415427971,0.747004933051445,0.148123765635286,0.112050739957717],'FontSize',14)
theme('light');
print(gcf, 'Supplementary_Figure_14.png','-dpng','-r300');

cmap_OR=[hex2rgb('#543005')
hex2rgb('#8c510a')
hex2rgb('#bf812d')
hex2rgb('#dfc27d')
hex2rgb('#f6e8c3')
hex2rgb('#f5f5f5')
hex2rgb('#c7eae5')
hex2rgb('#80cdc1')
hex2rgb('#35978f')
hex2rgb('#01665e')
hex2rgb('#003c30');];


cmap_OR=flip(interp1(linspace(0,1,size(cmap_OR,1)),cmap_OR,linspace(0,1,1001)));

figure('units','normalized','outerposition',[0 0.05 1 1])

uu =uv([3 5 7 9]);
for kk=1:4
    for gen=0:3
        gg=gen+4.*(kk-1);
        subplot('Position',[0.0575+0.23.*rem(gg,4) 0.78-0.49.*floor(gg/4)/2 0.195 0.20])
        temp = reshape(OR(gen+1,:),old_size);
    
        temp(temp>2)=2;
        contourf(R0t,kt,squeeze(temp(uv==uu(kk),:,:)),101,'LineStyle','none')
        yscale('log');
        clim([0 2]);
        % colormap(cmap)
        hold on;
    
    
        [C,h] =contour(R0t,kt,squeeze(temp(uv==uu(kk),:,:)),[1],'k','LineWidth',2,'LineStyle',':');
        h.LevelList=1;
        clabel(C,h,'Fontsize',12,'LabelSpacing',1000,'Color','k');
        set(gca,'TickDir','out','FontSize',12,'XTick',[0.4:0.2:2],'LineWidth',2);

        plot(ones(1,5),10.^linspace(-1,1,5),'Color',[0.75 0.75 0.75],'LineWidth',2,'LineStyle','-.')
        % contourf(uv,R0t,squeeze(temp(:,gg+1,:))',[0 1 max(OR(2,:))],'LineStyle','none');
        % clim([0 max(OR(2,:))])
        % yscale('log')
        xlabel('Reproduction number','Fontsize',12)
        if(gen==0)
                ylabel({['Underascertainment rate'],['(\mu= ' num2str(uu(kk),'%3.2f') ')'] , 'Dispersion coefficient'},'Fontsize',12) 
        else
            ylabel('Dispersion coefficient','Fontsize',12)
        end
        if(kk==1)
            title(['Generation ' num2str(gen) ],'Fontsize',12);
        end
        box off;
        text(-0.17,1,char(gg+65),'FontSize',20,'Units','normalized');

        colormap(cmap_OR)
    end
end

cb= colorbar;
cb.Position=[0.96    0.0454    0.0111    0.9350];
cb.FontSize=12;
cb.Label.String='Odds ratio of extinction relatave to detection';
cb.Label.Rotation=270;
cb.Label.FontSize=14;

cb.TickLabels{end}='2+';
theme('light')
print(gcf,['Supplementary_Figure_11.png'],'-dpng','-r300');

figure('units','normalized','outerposition',[0 0.05 1 1])

RR = R0t([1 5 7 10]);
for kk=1:4
    for gen=0:3
        gg=gen+4.*(kk-1);
        subplot('Position',[0.0575+0.23.*rem(gg,4) 0.78-0.49.*floor(gg/4)/2 0.195 0.20])
        temp = reshape(OR(gen+1,:),old_size);
    
        temp(temp>2)=2;
        contourf(uv,kt,squeeze(temp(:,:,RR(kk)==R0t))',101,'LineStyle','none')
        yscale('log');
        clim([0 2]);
        % colormap(cmap)
        hold on;
    
    
        [C,h] =contour(uv,kt,squeeze(temp(:,:,RR(kk)==R0t))',[1],'k','LineWidth',2,'LineStyle',':');
        h.LevelList=1;
        clabel(C,h,'Fontsize',12,'LabelSpacing',1000,'Color','k');
        set(gca,'TickDir','out','FontSize',12,'XTick',[0.05:0.15:0.95],'LineWidth',2);
        % contourf(uv,R0t,squeeze(temp(:,gg+1,:))',[0 1 max(OR(2,:))],'LineStyle','none');
        % clim([0 max(OR(2,:))])
        % yscale('log')
        xlabel('Underascertainment','Fontsize',12)
        if(gen==0)
            ylabel({'Basic reproduction number', ['(R_0= ' num2str(RR(kk),'%3.2f') ')'], 'Dispersion coefficient'},'Fontsize',12) 
        else
            ylabel('Dispersion coefficient','Fontsize',12)
        end
        if(kk==1)
            title(['Generation ' num2str(gen) ],'Fontsize',12);
        end
        box off;
        text(-0.17,1,char(gg+65),'FontSize',20,'Units','normalized');

        colormap(cmap_OR)
    end
end

cb= colorbar;
cb.Position=[0.96    0.0454    0.0111    0.9350];
cb.FontSize=12;
cb.Label.String='Odds ratio of extinction relatave to detection';
cb.Label.Rotation=270;
cb.Label.FontSize=14;

cb.TickLabels{end}='2+';
theme('light')

print(gcf,['Supplementary_Figure_10.png'],'-dpng','-r300');



%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Extinction upon detection
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

Cmap=[hex2rgb('#ffffff');
    hex2rgb('#fff7fb');
hex2rgb('#ece2f0');
hex2rgb('#d0d1e6');
hex2rgb('#a6bddb');
hex2rgb('#67a9cf');
hex2rgb('#3690c0');
hex2rgb('#02818a');
hex2rgb('#016c59');
hex2rgb('#014636');];

cmax_value=0.75;
C_map=(interp1(linspace(0,cmax_value,size(Cmap,1)),Cmap,linspace(0,cmax_value,1001)));
uu =uv([3 5 7 9]);
figure('units','normalized','outerposition',[0.2 0.2 0.7 0.7])
for gg=0:3
    R=reshape(E_Det,old_size);
    R=squeeze(R((uu(gg+1)==uv),:,:));
    subplot('Position',[0.065+0.45.*rem(gg,2) 0.58-0.49.*floor(gg/2) 0.39 0.37])
    contourf(R0t,kt,R,101,'LineStyle','none')
    yscale('log');
    colormap(C_map)
    clim([0 cmax_value]);
    hold on;
    [C,h] =contour(R0t,kt,R,[0.1 0.15:0.15:cmax_value],'k','LineWidth',2,'LineStyle',':');
     clabel(C,h,'Fontsize',12,'LabelSpacing',1000,'Color','k');
    plot(ones(1,5),10.^linspace(-1,1,5),'Color',[0.75 0.75 0.75],'LineWidth',2,'LineStyle','-.')
    ylabel('Dispersion coefficient (k)','FontSize',14)
    xlabel('Basic reproduction number ({\itR}_0)','FontSize',14)
    set(gca,'Fontsize',12,'tickdir','out','XTick',[0.01 0.25:0.25:2],'LineWidth',2);
    yscale('log');
    box off;
    title(['Underascertainment rate: ' num2str(uu(gg+1)*100) '%' ])
    text(-0.125,1.02,char(65+gg),'FontSize',28,'Units','normalized');
end

subplot('Position',[0.93 0.09 0.015 0.86])

p_ext=linspace(0,cmax_value,size(C_map,1));

for pp=1:length(p_ext)-1
    patch([0 1 1 0],[p_ext(pp) p_ext(pp) p_ext(pp+1) p_ext(pp+1)],interp1(linspace(0,cmax_value,size(Cmap,1)),Cmap,p_ext(pp)),'LineStyle','none');
end

p_ext=[0:0.15:cmax_value];
for pp=1:length(p_ext)
    text(1.2,p_ext(pp),num2str(p_ext(pp),'%3.2f'),'FontSize',12,'HorizontalAlignment','left','VerticalAlignment','middle')
end
text(3.5,cmax_value/2,'Average probability of extinction upon detection','Rotation',270,'HorizontalAlignment','center','VerticalAlignment','middle','FontSize',14)
set(gca,'YTick',[],'XTick',[])
xlim([0 1])
ylim([0 cmax_value])

theme('light')
print(gcf, 'Supplementary_Figure_12.png','-dpng','-r300');

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Generation of detection
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

Cmap=[hex2rgb('#ffffff');
    hex2rgb('#f7fcfd');
hex2rgb('#e0ecf4');
hex2rgb('#bfd3e6');
hex2rgb('#9ebcda');
hex2rgb('#8c96c6');
hex2rgb('#8c6bb1');
hex2rgb('#88419d');
hex2rgb('#810f7c');
hex2rgb('#4d004b');];

cmax_value=6.5;
C_map=(interp1(linspace(0,cmax_value,size(Cmap,1)),Cmap,linspace(0,cmax_value,1001)));
uu =uv([7 9 10 11]);
figure('units','normalized','outerposition',[0.2 0.2 0.7 0.7])
for gg=0:3
    R=reshape(Gen_Det,old_size);
    R=squeeze(R((uu(gg+1)==uv),:,:));
    subplot('Position',[0.065+0.45.*rem(gg,2) 0.58-0.49.*floor(gg/2) 0.39 0.37])
    contourf(R0t,kt,R,101,'LineStyle','none')
    yscale('log');
    colormap(C_map)
    clim([0 cmax_value]);
    hold on;
    [C,h] =contour(R0t,kt,R,[0:1:floor(cmax_value)],'k','LineWidth',2,'LineStyle',':');
     clabel(C,h,'Fontsize',12,'LabelSpacing',1000,'Color','k');
    plot(ones(1,5),10.^linspace(-1,1,5),'Color',[0.75 0.75 0.75],'LineWidth',2,'LineStyle','-.')
    ylabel('Dispersion coefficient (k)','FontSize',14)
    xlabel('Basic reproduction number ({\itR}_0)','FontSize',14)
    set(gca,'Fontsize',12,'tickdir','out','XTick',[0.01 0.25:0.25:2],'LineWidth',2);
    yscale('log');
    box off;
    title(['Underascertainment rate: ' num2str(uu(gg+1)*100) '%' ])
    text(-0.125,1.02,char(65+gg),'FontSize',28,'Units','normalized');
end

subplot('Position',[0.93 0.09 0.015 0.86])

p_ext=linspace(0,cmax_value,size(C_map,1));

for pp=1:length(p_ext)-1
    patch([0 1 1 0],[p_ext(pp) p_ext(pp) p_ext(pp+1) p_ext(pp+1)],interp1(linspace(0,cmax_value,size(Cmap,1)),Cmap,p_ext(pp)),'LineStyle','none');
end

p_ext=[0:0.5:cmax_value];
for pp=1:length(p_ext)
    text(1.2,p_ext(pp),num2str(p_ext(pp),'%3.2f'),'FontSize',12,'HorizontalAlignment','left','VerticalAlignment','middle')
end
text(3.5,cmax_value/2,'Average generation of detection','Rotation',270,'HorizontalAlignment','center','VerticalAlignment','middle','FontSize',14)
set(gca,'YTick',[],'XTick',[])
xlim([0 1])
ylim([0 cmax_value])

theme('light')
print(gcf, 'Supplementary_Figure_13.png','-dpng','-r300');