clear;
clc;
close all;

load('BVD_Model_Fit.mat')

figure('units','normalized','outerposition',[0.25 0.05 0.5 0.9])
subplot('Position',[0.1 0.56 0.87 0.42])
for tt=1:length(Date)    
    lb = prctile(Model_Deaths(:,tt),2.5);
    ub = prctile(Model_Deaths(:,tt),97.5);
    patch(tt+[-0.4 -0.4 0.4 0.4],[lb ub ub lb],hex2rgb('#002C54'),'FaceAlpha',0.3,'LineStyle','none'); hold on

    lb = prctile(Model_Deaths(:,tt),25);
    ub = prctile(Model_Deaths(:,tt),75);
    patch(tt+[-0.4 -0.4 0.4 0.4],[lb ub ub lb],hex2rgb('#002C54'),'FaceAlpha',0.3,'LineStyle','none'); hold on

    scatter(tt,Deaths(tt),20,'color',hex2rgb('#16253D'),'filled')

    lb = prctile(Model_Cases(:,tt),2.5);
    ub = prctile(Model_Cases(:,tt),97.5);
    patch(tt+[-0.4 -0.4 0.4 0.4],[lb ub ub lb],hex2rgb('#002C54'),'FaceAlpha',0.3,'LineStyle','none'); hold on
    
    lb = prctile(Model_Cases(:,tt),2.5);
    ub = prctile(Model_Cases(:,tt),97.5);
    patch(tt+[-0.4 -0.4 0.4 0.4],[lb ub ub lb],hex2rgb('#002C54'),'FaceAlpha',0.3,'LineStyle','none'); hold on
    scatter(tt,Cases(tt),20,'b','filled')
end
set(gca,'LineWidth',2,'TickDir','out','XTick',[1:length(Date)],'XTickLabel',{datestr(Date)},'FontSize',12)
ylabel('Cumulative incidence','FontSize',14)
xlabel('Date','FontSize',14)
xlim([0.5 length(Date)+0.5])
subplot('Position',[0.1 0.07 0.87 0.42])

for tt=1:length(Date)
    lb = prctile(Model_Deaths_Overall(:,tt),2.5);
    ub = prctile(Model_Deaths_Overall(:,tt),97.5);
    med =  prctile(Model_Deaths_Overall(:,tt),50);
    patch(tt+[-0.4 -0.4 0.4 0.4],[lb ub ub lb],'r','FaceAlpha',0.3,'LineStyle','none'); hold on
    plot(tt+[-0.4 0.4],[med med],'r','LineWidth',3);

    lb = prctile(Model_Cases_Overall(:,tt),2.5);
    ub = prctile(Model_Cases_Overall(:,tt),97.5);
    med =  prctile(Model_Cases_Overall(:,tt),50);
    patch(tt+[-0.4 -0.4 0.4 0.4],[lb ub ub lb],'b','FaceAlpha',0.3,'LineStyle','none'); hold on
    plot(tt+[-0.4 0.4],[med med],'b','LineWidth',3);
end

set(gca,'LineWidth',2,'TickDir','out','XTick',[1:length(Date)],'XTickLabel',{datestr(Date)},'FontSize',12)
ylabel('Cumulative incidence','FontSize',14)
xlabel('Date','FontSize',14)
xlim([0.5 length(Date)+0.5])
subplot('Position',[0.1 0.07 0.87 0.42])
theme('light')

